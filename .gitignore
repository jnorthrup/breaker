# Build artifacts
*.class
*.jar
# The Maven wrapper is the only-script kind: mvnw downloads the distribution itself and
# checks its SHA-256, so no wrapper jar is committed and none is excepted here.
*.apk
*.apk.idsig
*.aab
target/
build/
out/

# Models (downloaded, verified via checksums — never commit)
*.onnx
*.ort
models/

# Secrets & keys
*.pem
*.key
*.crt
*.p12
secrets/
.env

# Local state
*.db
*.sqlite
*.sqlite3
node_modules/
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Test and tool output
*.log
