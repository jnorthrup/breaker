diff --git a/.mvn/wrapper/maven-wrapper.properties b/.mvn/wrapper/maven-wrapper.properties
new file mode 100644
index 0000000000000000000000000000000000000000..a57944a812f6fbe87b20d090c8cea4af5db2c303
--- /dev/null
+++ b/.mvn/wrapper/maven-wrapper.properties
@@ -0,0 +1,14 @@
+# The distribution below is pinned to its SHA-256, so ./mvnw verifies the download and
+# fails loudly on a tampered or substituted distribution (Security Review fix #4, carried
+# over from the Gradle wrapper pin).
+# Apache publishes a SHA-512 and a PGP signature for each distribution, not a SHA-256: the
+# SHA-256 below was computed from apache-maven-3.10.0-bin.zip after that file matched the
+# published SHA-512 at both sources below and its .asc verified against the Maven KEYS file.
+# read 2026-10-06 from https://repo1.maven.org/maven2/org/apache/maven/apache-maven/3.10.0/apache-maven-3.10.0-bin.zip.sha512
+# read 2026-10-06 from https://downloads.apache.org/maven/maven-3/3.10.0/binaries/apache-maven-3.10.0-bin.zip.sha512
+# read 2026-10-06 from https://downloads.apache.org/maven/KEYS
+# only-script: no wrapper jar is committed; mvnw downloads with curl/wget and checks the sum.
+wrapperVersion=3.3.4
+distributionType=only-script
+distributionUrl=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.10.0/apache-maven-3.10.0-bin.zip
+distributionSha256Sum=1f6d9909266510f039f59aa0e13dcd2c66da85f043e56276e41f2918f8bddaff
