--- /dev/null
+++ b/pom.xml
@@ -0,0 +1,209 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <!-- Breaker — root POM: the parent of every module and the reactor root.
+
+       Every version lives here and only here (the role gradle/libs.versions.toml had).
+       Each one carries the registry it was read from and the day it was read.
+       Toolchain: Maven 3.10.0 via ./mvnw (distribution SHA-256 pinned in
+       .mvn/wrapper/maven-wrapper.properties) · Kotlin 2.4.20 · JDK 25 ·
+       compileSdk 36 · targetSdk 36 · minSdk 30. -->
+  <groupId>dev.breaker</groupId>
+  <artifactId>breaker</artifactId>
+  <version>0-SNAPSHOT</version>
+  <packaging>pom</packaging>
+
+  <modules>
+    <module>agent-skills</module>
+    <module>android</module>
+    <module>server</module>
+    <module>shared</module>
+  </modules>
+
+  <properties>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <java.release>25</java.release>
+    <android.compileSdk>36</android.compileSdk>
+    <android.targetSdk>36</android.targetSdk>
+    <android.minSdk>30</android.minSdk>
+    <android.jar>${env.ANDROID_HOME}/platforms/android-${android.compileSdk}/android.jar</android.jar>
+    <!-- read 2026-10-06 from https://repo1.maven.org/maven2/org/jetbrains/kotlin/kotlin-maven-plugin/maven-metadata.xml -->
+    <kotlin.version>2.4.20</kotlin.version>
+    <!-- read 2026-10-06 from https://repo1.maven.org/maven2/junit/junit/maven-metadata.xml -->
+    <junit.version>4.13.2</junit.version>
+    <!-- read 2026-10-06 from https://repo1.maven.org/maven2/org/xerial/sqlite-jdbc/maven-metadata.xml -->
+    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
+    <!-- read 2026-10-06 from https://repo1.maven.org/maven2/org/apache/maven/plugins/<artifact>/maven-metadata.xml, each -->
+    <clean.version>3.5.0</clean.version>
+    <resources.version>3.5.0</resources.version>
+    <compiler.version>3.16.0</compiler.version>
+    <surefire.version>3.6.0</surefire.version>
+    <jar.version>3.5.1</jar.version>
+    <install.version>3.2.0</install.version>
+    <deploy.version>3.2.0</deploy.version>
+    <site.version>3.22.0</site.version>
+    <enforcer.version>3.6.3</enforcer.version>
+    <dependency.version>3.11.0</dependency.version>
+    <!-- read 2026-10-06 from https://repo1.maven.org/maven2/org/codehaus/mojo/exec-maven-plugin/maven-metadata.xml -->
+    <exec.version>3.6.4</exec.version>
+    <!-- D8 (Java bytecode to dex), pinned here because build-tools 36.0.0 ships D8 8.10.9,
+         which rejects Java 25 class files ("Unsupported class file major version 69").
+         read 2026-10-06 from https://dl.google.com/android/maven2/com/android/tools/r8/maven-metadata.xml -->
+    <r8.version>9.5.22</r8.version>
+    <!-- aapt2, zipalign, apksigner: build-tools;36.0.0 as installed by sdkmanager
+         (checksum in dl.google.com/android/repository/repository2-3.xml), as CI does today. -->
+    <android.buildTools>36.0.0</android.buildTools>
+    <android.buildToolsDir>${env.ANDROID_HOME}/build-tools/${android.buildTools}</android.buildToolsDir>
+  </properties>
+
+  <!-- Same two repositories the Gradle settings declared: Google's (Android tooling) and Central. -->
+  <repositories>
+    <repository>
+      <id>google</id>
+      <url>https://dl.google.com/android/maven2</url>
+      <releases><checksumPolicy>fail</checksumPolicy></releases>
+      <snapshots><enabled>false</enabled></snapshots>
+    </repository>
+  </repositories>
+
+  <dependencyManagement>
+    <dependencies>
+      <!-- The Android platform API. Not on any public Maven repository: it comes from the
+           SDK platform package (platforms;android-36 = platform-36_r02.zip, checksum in
+           dl.google.com/android/repository/repository2-3.xml), installed by sdkmanager,
+           and is copied into the local repository by the root build (install-android-jar
+           below). Scope provided, not system: a system path is an ${env...} expression,
+           and a POM holding one is INVALID when read back from a repository, which makes
+           Maven drop that module's transitive dependencies with a warning (spike 001). -->
+      <dependency>
+        <groupId>dev.breaker.sdk</groupId>
+        <artifactId>android</artifactId>
+        <version>${android.compileSdk}</version>
+        <scope>provided</scope>
+      </dependency>
+      <dependency>
+        <groupId>org.xerial</groupId>
+        <artifactId>sqlite-jdbc</artifactId>
+        <version>${sqlite-jdbc.version}</version>
+      </dependency>
+    </dependencies>
+  </dependencyManagement>
+
+  <!-- Every module gets the Kotlin standard library and the JUnit runner, as the Kotlin
+       Gradle plugin and each build file's testImplementation(libs.junit) gave them. -->
+  <dependencies>
+    <dependency>
+      <groupId>org.jetbrains.kotlin</groupId>
+      <artifactId>kotlin-stdlib</artifactId>
+      <version>${kotlin.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>junit</groupId>
+      <artifactId>junit</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
+    <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
+    <pluginManagement>
+      <plugins>
+        <plugin>
+          <groupId>org.jetbrains.kotlin</groupId>
+          <artifactId>kotlin-maven-plugin</artifactId>
+          <version>${kotlin.version}</version>
+          <configuration>
+            <jvmTarget>${java.release}</jvmTarget>
+          </configuration>
+          <executions>
+            <execution>
+              <id>compile</id>
+              <goals><goal>compile</goal></goals>
+            </execution>
+            <execution>
+              <id>test-compile</id>
+              <goals><goal>test-compile</goal></goals>
+            </execution>
+          </executions>
+        </plugin>
+        <plugin>
+          <artifactId>maven-surefire-plugin</artifactId>
+          <version>${surefire.version}</version>
+          <configuration>
+            <trimStackTrace>false</trimStackTrace>
+            <systemPropertyVariables>
+              <breaker.repoRoot>${maven.multiModuleProjectDirectory}</breaker.repoRoot>
+            </systemPropertyVariables>
+          </configuration>
+        </plugin>
+        <plugin><artifactId>maven-clean-plugin</artifactId><version>${clean.version}</version></plugin>
+        <plugin><artifactId>maven-resources-plugin</artifactId><version>${resources.version}</version></plugin>
+        <plugin><artifactId>maven-compiler-plugin</artifactId><version>${compiler.version}</version>
+          <configuration><release>${java.release}</release></configuration></plugin>
+        <plugin><artifactId>maven-jar-plugin</artifactId><version>${jar.version}</version></plugin>
+        <plugin><artifactId>maven-install-plugin</artifactId><version>${install.version}</version></plugin>
+        <plugin><artifactId>maven-deploy-plugin</artifactId><version>${deploy.version}</version></plugin>
+        <plugin><artifactId>maven-site-plugin</artifactId><version>${site.version}</version></plugin>
+        <plugin><artifactId>maven-dependency-plugin</artifactId><version>${dependency.version}</version></plugin>
+        <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>${exec.version}</version></plugin>
+      </plugins>
+    </pluginManagement>
+    <plugins>
+      <!-- Copies the SDK's android.jar (installed and checksum-verified by sdkmanager) into
+           the local repository as dev.breaker.sdk:android:${android.compileSdk}, so every
+           Android module depends on it as an ordinary provided-scope artifact. Root only. -->
+      <plugin>
+        <artifactId>maven-install-plugin</artifactId>
+        <version>${install.version}</version>
+        <inherited>false</inherited>
+        <executions>
+          <execution>
+            <id>install-android-jar</id>
+            <phase>validate</phase>
+            <goals><goal>install-file</goal></goals>
+            <configuration>
+              <file>${android.jar}</file>
+              <groupId>dev.breaker.sdk</groupId>
+              <artifactId>android</artifactId>
+              <version>${android.compileSdk}</version>
+              <packaging>jar</packaging>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+      <plugin>
+        <artifactId>maven-enforcer-plugin</artifactId>
+        <version>${enforcer.version}</version>
+        <executions>
+          <execution>
+            <id>breaker-rules</id>
+            <goals><goal>enforce</goal></goals>
+            <configuration>
+              <rules>
+                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
+                <!-- No plugin runs at an unpinned version. -->
+                <requirePluginVersions/>
+                <!-- History's JVM tests run on desktop SQLite; the driver must never ship.
+                     Checked on the RESOLVED graph, transitive edges included. -->
+                <bannedDependencies>
+                  <searchTransitive>true</searchTransitive>
+                  <excludes>
+                    <exclude>org.xerial:sqlite-jdbc:*:*:compile</exclude>
+                    <exclude>org.xerial:sqlite-jdbc:*:*:runtime</exclude>
+                    <exclude>org.xerial:sqlite-jdbc:*:*:provided</exclude>
+                    <exclude>org.xerial:sqlite-jdbc:*:*:system</exclude>
+                  </excludes>
+                  <message>sqlite-jdbc is test-only (android/modules/history card): it must never reach a shipped classpath.</message>
+                </bannedDependencies>
+              </rules>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+    </plugins>
+  </build>
+</project>
